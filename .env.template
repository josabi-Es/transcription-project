# ─────────────────────────────────────────────────────────────────
# Transcription Service - Environment Variables
# Copy this file to .env and adjust values as needed
# ─────────────────────────────────────────────────────────────────

# Model size: tiny | base | small | medium | large-v3
# tiny    →  40 MB,  fastest, low accuracy
# base    → 140 MB,  fast,    fair accuracy
# medium  → 770 MB,  balanced, good accuracy  (default)
# large-v3→   3 GB,  slow,    best accuracy
WHISPER_MODEL=medium

# Device: gpu | cpu | auto
# gpu  → force GPU (CUDA), fails if no GPU available (default)
# cpu  → force CPU always (slower, no CUDA required)
# auto → use GPU if available, fall back to CPU
WHISPER_DEVICE=gpu

# (Windows only) Path to CUDA Toolkit bin folder if not already in system PATH
# Use forward slashes: C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.6/bin
# Leave empty if CUDA is already in the system PATH
CUDA_BIN_PATH=

# Storage directories
MODELS_DIR=./storage/models
OUTPUT_DIR=./storage/output

# ── Inference hyperparameters ──────────────────────────────────────
# beam_size: beam search width. 1 = fastest (greedy), 3 = balanced, 5 = quality
WHISPER_BEAM_SIZE=3

# vad_filter: skip silence automatically (true | false)
# Recommended true for long videos with pauses
WHISPER_VAD_FILTER=true

# condition_on_previous_text: use prior segment as context (true | false)
# Improves coherence but can propagate errors on noisy audio
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true

# initial_prompt: optional text to guide the transcription style/vocabulary
# Leave empty for no prompt
WHISPER_INITIAL_PROMPT=

# ── Gemini API (for /format endpoint) ─────────────────────────────
# Get your key at https://aistudio.google.com/apikey
# This exact name is what the google-genai SDK reads by default
GEMINI_API_KEY=

# Model used to reformat transcriptions
GEMINI_MODEL=gemini-3.6-flash

# Folder with the prompt files (one .md per prompt, filename = prompt_id)
PROMPTS_DIR=./prompt

# Max input characters accepted by /format.
# The real ceiling is the model's OUTPUT limit (65,536 tokens ≈ 195,000 chars),
# and the bilingual prompt emits ~2.1x the input, so ~90,000 chars is the
# theoretical max. 50,000 (≈55 min of speech) leaves comfortable margin.
FORMAT_MAX_CHARS=50000
