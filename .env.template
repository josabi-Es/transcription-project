# ─────────────────────────────────────────────────────────────────
# Transcription Service - Environment Variables
# Copy this file to .env and adjust values as needed
# ─────────────────────────────────────────────────────────────────

# Model size: tiny | base | small | medium | large-v3
# tiny    → 40 MB,  fastest, good accuracy   (default)
# base    → 140 MB, fast,    better accuracy
# large-v3→ 3 GB,   slow,    best accuracy
WHISPER_MODEL=tiny

# Input directory: where your video/audio files are located
# Leave empty to use file upload via API instead
INPUT_DIR=./input

# Output directory: where transcriptions (.txt) will be saved
# Files are named identically to the input (e.g. video.mp4 → video.txt)
OUTPUT_DIR=./output