# Copy to .env and adjust.

# ── Ports ───────────────────────────────────────────
BACKEND_PORT=8000
UI_PORT=8501

# ── Whisper ─────────────────────────────────────────
# Model: tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
WHISPER_MODEL=medium
# Device: gpu | cpu | auto (gpu fails without CUDA)
WHISPER_DEVICE=gpu
# (Windows only) CUDA Toolkit bin folder, if not already on PATH
CUDA_BIN_PATH=

MODELS_DIR=./storage/models
OUTPUT_DIR=./storage/output

# beam_size: 1=fastest, 3=balanced, 5=quality
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_INITIAL_PROMPT=

# ── Gemini (for /format) ────────────────────────────
# Key at https://aistudio.google.com/apikey — this exact name is what
# the google-genai SDK reads by default
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PROMPTS_DIR=./prompt
# Output limit is 65,536 tokens (~195,000 chars) and the bilingual prompt
# emits ~2.1x the input, so keep this well under ~90,000
FORMAT_MAX_CHARS=50000
