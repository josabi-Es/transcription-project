# Transcription Project - Environment Variables (Optional)

# Model size: tiny, base, small, medium, large-v3
DEFAULT_MODEL=tiny

# Language code (leave empty for auto-detect)
# Examples: es (Spanish), en (English), fr (French), de (German)
DEFAULT_LANGUAGE=

# Output directory for transcriptions
OUTPUT_DIR=./output

# Verbose logging (True/False)
VERBOSE=False
